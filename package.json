{
  "name": "hotsrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "pnpm": ">=10.15"
  },
  "scripts": {
    "dev": "objectstack dev",
    "setup:local": "node scripts/setup-local.mjs",
    "start": "objectstack start",
    "build": "objectstack build",
    "validate": "objectstack validate",
    "lint": "objectstack lint --strict",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "objectstack i18n check --strict",
    "verify": "pnpm validate && pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@objectstack/runtime": "18.0.0",
    "@objectstack/spec": "18.0.0"
  },
  "devDependencies": {
    "@objectstack/cli": "18.0.0",
    "@objectstack/skills": "18.0.0",
    "@objectstack/verify": "18.0.0",
    "typescript": "^5.3.0",
    "vitest": "~4.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
